        <div class="nav-container">
            <a href="#" class="logo">My Online Store</a>
            <div class="cart-icon">🛒 Shop Now</div>
        </div>
    </header>

    <section class="hero">
        <h1>Welcome to My Store</h1>
        <p>Discover our exclusive collection of high-quality products shipped straight to your door.</p>
    </section>

    <main class="store-container">
        <h2 class="section-title">Our Featured Products</h2>
        <div class="product-grid">

            <!-- Product 1 -->
            <div class="product-card">
                <div class="product-img">Product Image 1</div>
